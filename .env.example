# ProcureAI Environment Configuration
# Copy this file to .env and configure your sandbox credentials. Never commit real keys.

# Server & Deployment Runtime
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# SQLite Database Path (On Render: /var/data/procureai.db for Starter persistent disk)
DB_PATH=procureai.db
DATABASE_PATH=procureai.db

# Admin Key for resetting demo database in production
DEMO_RESET_KEY=

# PayPal Sandbox Configuration
# Obtain credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_VENDOR_EMAIL=vendor-sb-account@business.example.com

# Google Gemini AI Configuration
# Obtain API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Channel3 Live Catalog API (Optional Merchant Aggregator)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.channel3.ai/v1

# AI Rate Limiting & Protection
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_AI_PER_DAY=250
GLOBAL_DAILY_AI_CEILING=1000
