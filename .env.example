# Copy to .env and fill in your OWN PayPal sandbox app credentials.
# Never commit .env or put real values in this file.
PORT=3000
# Request intelligence (server only; never use a VITE_ prefix for this key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: disable the demo-only catalog override routes
# PROCUREMENT_DEMO_ROUTES=off
