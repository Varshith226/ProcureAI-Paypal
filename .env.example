# ProcureAI Environment Configuration
# Copy to .env and fill in your sandbox credentials. Never commit real keys.

# Server & Database
PORT=3000
DATABASE_PATH=procureai.db
NODE_ENV=development

# PayPal Sandbox Configuration
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
PAYPAL_VENDOR_EMAIL=vendor-sb-account@business.example.com

# Google Gemini AI Configuration
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Channel3 Live E-commerce Catalog API (Optional Hackathon Sponsor Integration)
# Obtain from https://channel3.ai/
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.channel3.ai/v1

# Frontend Vite variables (configured in client/.env or build)
# VITE_PAYPAL_CLIENT_ID=your-sandbox-client-id
# VITE_API_BASE_URL=http://localhost:3000
